{
  "manifest_version": 3,
  "name": "Home Base",
  "version": "4.3.0",
  "description": "Your own new tab page: search, your saved sites on every device, most visited pages and bookmarks.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "bookmarks",
    "favicon",
    "identity",
    "search",
    "storage",
    "topSites"
  ],
  "host_permissions": [
    "https://chrome.ruhul0.com/*"
  ]
}
